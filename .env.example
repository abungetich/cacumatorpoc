DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mentorship_os?schema=public"
AUTH_SECRET="replace-with-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
# Preferred: ZeptoMail REST API
ZEPTO_URL="https://api.zeptomail.com/v1.1/email"
ZEPTO_TOKEN="Zoho-enczapikey <replace-with-zeptomail-token>"
ZEPTO_FROM_ADDRESS="noreply@waziflow.com"
