# Optional fallback: SMTP
SMTP_HOST="smtp.zeptomail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="emailapikey"
SMTP_PASS="replace-with-zeptomail-api-key"
SMTP_FROM="Cacumator <no-reply@waziflow.com>"
