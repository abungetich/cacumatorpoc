  sortOrder        Int             @default(0) @map("sort_order")
  createdById      String          @map("created_by_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  application GrantApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  assignee    User?            @relation("GrantTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy   User             @relation("GrantTaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy  User?            @relation("GrantTaskReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([applicationId, status])
  @@index([reviewStatus, reviewedAt])
  @@index([assigneeId, status])
  @@index([reviewedById])
  @@index([dueDate])
  @@map("grant_tasks")
}

model GrantApproval {
  id            String             @id @default(uuid()) @db.Uuid
  applicationId String             @map("application_id") @db.Uuid
  approvalType  GrantApprovalType  @map("approval_type")
  status        GrantApprovalStatus @default(PENDING)
  requestedById String             @map("requested_by_id") @db.Uuid
  requestedAt   DateTime           @default(now()) @map("requested_at") @db.Timestamptz(6)
  resolvedById  String?            @map("resolved_by_id") @db.Uuid
  resolvedAt    DateTime?          @map("resolved_at") @db.Timestamptz(6)
  notes         String?            @db.Text
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  application GrantApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  requestedBy User             @relation("GrantApprovalRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  resolvedBy  User?            @relation("GrantApprovalResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([applicationId, approvalType])
  @@index([status, approvalType])
  @@index([requestedById, requestedAt])
  @@index([resolvedById, resolvedAt])
  @@map("grant_approvals")
}

model GrantSubmission {
  id                     String    @id @default(uuid()) @db.Uuid
  applicationId          String    @unique @map("application_id") @db.Uuid
  submittedById          String    @map("submitted_by_id") @db.Uuid
  submittedAt            DateTime  @default(now()) @map("submitted_at") @db.Timestamptz(6)
  confirmationReference  String?   @map("confirmation_reference")
  proofUrl               String?   @map("proof_url")
  packageVersion         String?   @map("package_version")
  notes                  String?   @db.Text
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  application GrantApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  submittedBy User             @relation("GrantSubmissionSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)

  @@index([submittedById, submittedAt])
  @@map("grant_submissions")
}

model Consent {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @map("user_id") @db.Uuid
  consentType  ConsentType @map("consent_type")
  version      String
  agreedAt     DateTime    @default(now()) @map("agreed_at") @db.Timestamptz(6)
  agreedByIp   String      @map("agreed_by_ip")
  documentUrl  String      @map("document_url")
  evidenceUrl  String?     @map("evidence_url")
  expiresAt    DateTime?   @map("expires_at") @db.Date
  revokedAt    DateTime?   @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consentType, agreedAt])
  @@index([expiresAt, revokedAt])
  @@map("consents")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String   @map("ip_address")
  userAgent  String   @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}
