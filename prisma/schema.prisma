generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

enum PartnerType {
  NGO
  CORPORATE
  FOUNDATION
  GOVERNMENT
}

enum OrganizationType {
  CORPORATE
  NGO
  FOUNDATION
  GOVERNMENT
  ALUMNI
  ASSOCIATION
  COMMUNITY
  FAITH_BASED
  OTHER
}

enum OrganizationStatus {
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum OrganizationMembershipRole {
  ADMIN
  COORDINATOR
  MEMBER
  SUPPORT_LEAD
  VIEWER
}

enum OrganizationMembershipStatus {
  INVITED
  PENDING
  ACTIVE
  SUSPENDED
  LEFT
}

enum SchoolType {
  PRIMARY
  SECONDARY
  COLLEGE
  UNIVERSITY
  VOCATIONAL
}

enum SocioEconomicTier {
  LOW
  LOWER_MIDDLE
  MIDDLE
  UPPER_MIDDLE
  HIGH
}

enum UserRole {
  MENTOR
  MENTEE
  SCHOOL_ADMIN
  PLATFORM_ADMIN
  GUARDIAN
  PARTNER_ADMIN
  ORGANIZATION_ADMIN
}

enum EducationLevel {
  PRIMARY
  SECONDARY
  COLLEGE
  UNIVERSITY
  VOCATIONAL
}

enum EnrollmentStatus {
  FULL_TIME
  PART_TIME
}

enum MentorBackgroundCheckStatus {
  PENDING
  CLEARED
  FAILED
  EXPIRED
}

enum MentorProfileStatus {
  PENDING
  APPROVED
  REJECTED
  INACTIVE
}

enum MentorOnboardingStage {
  SIGNUP
  EMAIL_VERIFIED
  PROFILE_CREATED
  INTERESTS_SELECTED
  TRAINING_COMPLETED
  CONSENT_SIGNED
  BACKGROUND_CHECK_PENDING
  APPROVED
  PROGRAM_ELIGIBLE
  MATCHING
  ACTIVE
  ALUMNI
}

enum MentorReadinessState {
  PENDING_REGISTRATION
  PENDING_BACKGROUND_CHECK
  PENDING_TRAINING
  PENDING_ADMIN_REVIEW
  MATCHABLE
  ASSIGNED
  ACTIVE
  PAUSED
  INACTIVE
}

enum MentorProgramApplicationStatus {
  PENDING
  APPROVED
  WAITLISTED
  REJECTED
  WITHDRAWN
}

enum MenteeProfileStatus {
  ACTIVE
  WAITING
  MATCHED
  INACTIVE
}

enum MenteeIntakeStage {
  CONSENT_REQUIRED
  AWAITING_MATCHING
  MATCHED
  ACTIVE
  INACTIVE
}

enum MentorshipStatus {
  PENDING
  ACTIVE
  PAUSED
  COMPLETED
  TERMINATED
}

enum CheckInFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum MatchDeclineCategory {
  AVAILABILITY
  FORMAT
  FIT
  CONTEXT
  OTHER
}

enum MentorshipOutcome {
  SUCCESSFUL
  PARTIAL
  UNSUCCESSFUL
}

enum SessionFormat {
  ONLINE
  IN_PERSON
  PHONE
}

enum MentoringFormat {
  ONLINE
  IN_PERSON
  HYBRID
}

enum SessionAttendanceStatus {
  SCHEDULED
  COMPLETED
  MISSED
  CANCELLED
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  ACHIEVED
  ABANDONED
}

enum FeedbackType {
  MID_TERM
  END_TERM
  MONTHLY
}

enum ConsentType {
  DATA_PROCESSING
  PHOTO_RELEASE
  MENTORSHIP_AGREEMENT
  SAFEGUARDING
}

enum GrantOpportunityStatus {
  DISCOVERED
  QUALIFYING
  PURSUING
  ARCHIVED
}

enum GrantFunderType {
  FOUNDATION
  GOVERNMENT
  CORPORATE
  NGO
  MULTILATERAL
  OTHER
}

enum GrantSourceType {
  TEAM
  BOARD
  WEBSITE
  LINKEDIN
  EMAIL
  REFERRAL
  OTHER
}

enum GrantApplicationStage {
  DISCOVERY
  APPROVAL
  WRITING
  SUBMISSION
  SUBMITTED
  CLOSED
}

enum GrantTaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum GrantTaskReviewStatus {
  PENDING
  APPROVED
  REWORK_REQUIRED
}

enum GrantApprovalType {
  PURSUE
  BUDGET
  FINAL_SUBMISSION
}

enum GrantApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Partner {
  id                   String   @id @default(uuid()) @db.Uuid
  name                 String
  type                 PartnerType
  contactPerson        String   @map("contact_person")
  contactEmail         String   @map("contact_email")
  contactPhone         String?  @map("contact_phone")
  partnershipAgreement Json?    @map("partnership_agreement")
  logoUrl              String?  @map("logo_url")
  website              String?
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  schools School[]
  users   User[]
  organizations Organization[]
  grantOpportunities GrantOpportunity[]
  grantApplications  GrantApplication[]

  @@index([name])
  @@index([type])
  @@map("partners")
}

model Organization {
  id                   String             @id @default(uuid()) @db.Uuid
  partnerId            String?            @map("partner_id") @db.Uuid
  name                 String
  slug                 String             @unique
  type                 OrganizationType
  status               OrganizationStatus @default(PENDING_REVIEW)
  registrationNumber   String?            @map("registration_number")
  website              String?
  logoUrl              String?            @map("logo_url")
  description          String?            @db.Text
  mission              String?            @db.Text
  country              String
  county               String?
  city                 String?
  address              String?            @db.Text
  contactEmail         String             @map("contact_email")
  contactPhone         String?            @map("contact_phone")
  primaryContactName   String             @map("primary_contact_name")
  primaryContactTitle  String?            @map("primary_contact_title")
  adminFirstName       String             @map("admin_first_name")
  adminLastName        String             @map("admin_last_name")
  adminEmail           String             @map("admin_email")
  adminPhone           String             @map("admin_phone")
  adminTitle           String?            @map("admin_title")
  mentorParticipation  Boolean            @default(true) @map("mentor_participation")
  financialSupport     Boolean            @default(false) @map("financial_support")
  inKindSupport        Boolean            @default(false) @map("in_kind_support")
  schoolsOfInterest    Json?              @map("schools_of_interest")
  publicProfileEnabled Boolean            @default(false) @map("public_profile_enabled")
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  partner     Partner?                  @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  memberships OrganizationMembership[]
  agreements  OrganizationAgreement[]

  @@index([partnerId])
  @@index([status])
  @@index([name])
  @@index([adminEmail])
  @@map("organizations")
}

model PlatformBranding {
  id                String   @id @default("default")
  platformName      String   @default("Cacumator Mentorship Platform") @map("platform_name")
  logoUrl           String?  @map("logo_url")
  ceoName           String   @default("Grace Munyiri") @map("ceo_name")
  ceoTitle          String   @default("Chief Executive Officer") @map("ceo_title")
  ceoWelcomeMessage String   @default("Welcome to the Cacumator Mentorship Platform. We built this platform to create a safe, structured, and accountable path for mentors, organizations, and supporters to help young people thrive.") @map("ceo_welcome_message") @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("platform_branding")
}

model VerificationSettings {
  id                  String   @id @default("default")
  autoReminderEnabled Boolean  @default(false) @map("auto_reminder_enabled")
  resendIntervalHours Int      @default(24) @map("resend_interval_hours")
  maxReminders        Int      @default(3) @map("max_reminders")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("verification_settings")
}

model MatchingSettings {
  id                           String   @id @default("default")
  interestsWeight              Int      @default(30) @map("interests_weight")
  contextWeight                Int      @default(20) @map("context_weight")
  availabilityWeight           Int      @default(20) @map("availability_weight")
  formatWeight                 Int      @default(15) @map("format_weight")
  capacityWeight               Int      @default(15) @map("capacity_weight")
  penalizeNearCapacity         Boolean  @default(true) @map("penalize_near_capacity")
  nearCapacityPenalty          Int      @default(8) @map("near_capacity_penalty")
  penalizeLowAvailability      Boolean  @default(true) @map("penalize_low_availability")
  lowAvailabilityPenalty       Int      @default(6) @map("low_availability_penalty")
  penalizeWeakContext          Boolean  @default(true) @map("penalize_weak_context")
  weakContextPenalty           Int      @default(4) @map("weak_context_penalty")
  penalizePriorDecline         Boolean  @default(true) @map("penalize_prior_decline")
  priorDeclinePenalty          Int      @default(12) @map("prior_decline_penalty")
  excludePriorDeclinedPair     Boolean  @default(false) @map("exclude_prior_declined_pair")
  maxOpenMentorshipsPerMentee  Int      @default(3) @map("max_open_mentorships_per_mentee")
  availabilityDeclinePenalty   Int      @default(10) @map("availability_decline_penalty")
  formatDeclinePenalty         Int      @default(9) @map("format_decline_penalty")
  fitDeclinePenalty            Int      @default(8) @map("fit_decline_penalty")
  contextDeclinePenalty        Int      @default(7) @map("context_decline_penalty")
  otherDeclinePenalty          Int      @default(6) @map("other_decline_penalty")
  createdAt                    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("matching_settings")
}

model ConsentNotificationSettings {
  id                            String   @id @default("default")
  notifyPlatformAdminsOnDecline Boolean  @default(false) @map("notify_platform_admins_on_decline")
  createdAt                     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("consent_notification_settings")
}

model MentorTrainingModuleSetting {
  id               String   @id @default(uuid()) @db.Uuid
  title            String
  description      String   @db.Text
  moduleBody       String   @default("") @map("module_body") @db.Text
  version          String
  required         Boolean  @default(true)
  passingScore     Int      @default(100) @map("passing_score")
  maxAttempts      Int?     @map("max_attempts")
  estimatedMinutes Int?     @map("estimated_minutes")
  sortOrder        Int      @default(0) @map("sort_order")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  completions MentorTrainingCompletion[]
  questions   MentorTrainingQuestion[]
  attempts    MentorTrainingAttempt[]

  @@index([isActive, sortOrder])
  @@map("mentor_training_module_settings")
}

model MentorTrainingQuestion {
  id             String                     @id @default(uuid()) @db.Uuid
  moduleId       String                     @map("module_id") @db.Uuid
  prompt         String                     @db.Text
  explanation    String?                    @db.Text
  questionType   MentorTrainingQuestionType @default(SINGLE_CHOICE) @map("question_type")
  options        Json
  correctAnswer  String                     @map("correct_answer")
  correctAnswers Json                       @default("[]") @map("correct_answers")
  imageUrl       String?                    @map("image_url")
  sortOrder      Int                        @default(0) @map("sort_order")
  isActive       Boolean                    @default(true) @map("is_active")
  createdAt      DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  module MentorTrainingModuleSetting @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId, isActive, sortOrder])
  @@map("mentor_training_questions")
}

enum MentorTrainingQuestionType {
  SINGLE_CHOICE
  MULTI_CHOICE
}

model MentorTrainingAttempt {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  moduleId         String   @map("module_id") @db.Uuid
  score            Int
  passed           Boolean
  acknowledgedName String   @map("acknowledged_name")
  answers          Json
  submittedAt      DateTime @map("submitted_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  module MentorTrainingModuleSetting @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId, submittedAt])
  @@index([userId, moduleId, submittedAt])
  @@map("mentor_training_attempts")
}

model MentorTrainingCompletion {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  moduleId         String   @map("module_id") @db.Uuid
  acknowledgedName String   @map("acknowledged_name")
  completedAt      DateTime @map("completed_at") @db.Timestamptz(6)
  notes            String?  @db.Text
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  module MentorTrainingModuleSetting @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@index([moduleId, completedAt])
  @@index([userId, completedAt])
  @@map("mentor_training_completions")
}

model MentorConsentSetting {
  id          String      @id @default(uuid()) @db.Uuid
  title       String
  consentType ConsentType @map("consent_type")
  version     String
  summary     String      @db.Text
  documentBody String     @default("") @map("document_body") @db.Text
  documentUrl String      @map("document_url")
  required    Boolean     @default(true)
  sortOrder   Int         @default(0) @map("sort_order")
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive, sortOrder])
  @@index([consentType, isActive])
  @@map("mentor_consent_settings")
}

model School {
  id                  String            @id @default(uuid()) @db.Uuid
  partnerId           String?           @map("partner_id") @db.Uuid
  name                String
  type                SchoolType
  address             String            @db.Text
  phone               String
  email               String
  principalName       String            @map("principal_name")
  principalEmail      String            @map("principal_email")
  studentPopulation   Int?              @map("student_population")
  socioEconomicTier   SocioEconomicTier? @map("socio_economic_tier")
  programsOffered     Json?             @map("programs_offered")
  accreditationStatus String?           @map("accreditation_status")
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  partner        Partner?        @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  users          User[]
  menteeProfiles MenteeProfile[]
  programs       Program[]
  grantOpportunities GrantOpportunity[]
  grantApplications  GrantApplication[]

  @@index([partnerId])
  @@index([type])
  @@index([name])
  @@map("schools")
}

model User {
  id               String   @id @default(uuid()) @db.Uuid
  email            String   @unique
  password         String
  firstName        String   @map("first_name")
  middleName       String?  @map("middle_name")
  lastName         String   @map("last_name")
  phone            String
  dateOfBirth      DateTime @map("date_of_birth") @db.Date
  role             UserRole
  schoolId         String?  @map("school_id") @db.Uuid
  partnerId        String?  @map("partner_id") @db.Uuid
  timeZone         String?  @map("time_zone")
  profilePhoto     String?  @map("profile_photo")
  emailVerifiedAt  DateTime? @map("email_verified_at") @db.Timestamptz(6)
  twoFactorEnabled Boolean  @default(false) @map("two_factor_enabled")
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz(6)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  school                  School?         @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  partner                 Partner?        @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  mentorProfile           MentorProfile?
  menteeProfile           MenteeProfile?
  approvedMentorProfiles  MentorProfile[] @relation("MentorApprovedBy")
  mentorshipsAsMentor     Mentorship[]    @relation("MentorshipMentor")
  mentorshipsAsMentee     Mentorship[]    @relation("MentorshipMentee")
  declinedMentorshipAcceptances MentorshipAcceptance[] @relation("MentorshipDeclinedBy")
  sessionsCreated         Session[]       @relation("SessionCreatedBy")
  feedbackGiven           Feedback[]      @relation("FeedbackFromUser")
  feedbackReceived        Feedback[]      @relation("FeedbackToUser")
  consents                Consent[]
  auditLogs               AuditLog[]
  guardianForMentees      MenteeProfile[] @relation("GuardianUser")
  createdGrantOpportunities GrantOpportunity[] @relation("GrantOpportunityCreatedBy")
  scoredGrantOpportunities  GrantOpportunity[] @relation("GrantOpportunityScoredBy")
  createdGrantApplications  GrantApplication[] @relation("GrantApplicationCreatedBy")
  submittedGrantApplications GrantApplication[] @relation("GrantApplicationSubmittedBy")
  createdGrantTasks       GrantTask[]     @relation("GrantTaskCreatedBy")
  assignedGrantTasks      GrantTask[]     @relation("GrantTaskAssignee")
  reviewedGrantTasks      GrantTask[]     @relation("GrantTaskReviewedBy")
  requestedGrantApprovals GrantApproval[] @relation("GrantApprovalRequestedBy")
  resolvedGrantApprovals  GrantApproval[] @relation("GrantApprovalResolvedBy")
  grantSubmissions        GrantSubmission[] @relation("GrantSubmissionSubmittedBy")
  tenantInvite            TenantUserInvite? @relation("TenantInviteUser")
  sentTenantInvites       TenantUserInvite[] @relation("TenantInviteSender")
  mentorOnboarding        MentorOnboarding?
  mentorProgramApplications MentorProgramApplication[] @relation("MentorProgramApplications")
  reviewedMentorProgramApplications MentorProgramApplication[] @relation("MentorProgramApplicationReviewedBy")
  organizationMemberships OrganizationMembership[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens    PasswordResetToken[]
  mentorTrainingCompletions MentorTrainingCompletion[]
  mentorTrainingAttempts MentorTrainingAttempt[]

  @@index([role])
  @@index([schoolId])
  @@index([partnerId])
  @@index([isActive])
  @@map("users")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  email     String
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([userId, expiresAt, verifiedAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  email      String
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt     DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([userId, expiresAt, usedAt])
  @@map("password_reset_tokens")
}

model OrganizationMembership {
  id             String                       @id @default(uuid()) @db.Uuid
  organizationId String                       @map("organization_id") @db.Uuid
  userId         String                       @map("user_id") @db.Uuid
  role           OrganizationMembershipRole   @default(MEMBER)
  status         OrganizationMembershipStatus @default(PENDING)
  title          String?
  department     String?
  createdAt      DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId, status])
  @@index([userId, status])
  @@map("organization_memberships")
}

model OrganizationAgreement {
  id            String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code          String
  title         String
  version       String
  agreedByName  String   @map("agreed_by_name")
  agreedByEmail String   @map("agreed_by_email")
  documentBody  String?  @map("document_body") @db.Text
  documentUrl   String?  @map("document_url")
  agreedAt      DateTime @map("agreed_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, code])
  @@map("organization_agreements")
}

model TenantUserInvite {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  email       String
  tokenHash   String   @unique @map("token_hash")
  invitedById String   @map("invited_by_id") @db.Uuid
  invitedAt   DateTime @default(now()) @map("invited_at") @db.Timestamptz(6)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      User @relation("TenantInviteUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User @relation("TenantInviteSender", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([email])
  @@index([invitedById, invitedAt])
  @@index([expiresAt, acceptedAt])
  @@map("tenant_user_invites")
}

model MentorProfile {
  id                      String                      @id @default(uuid()) @db.Uuid
  userId                  String                      @unique @map("user_id") @db.Uuid
  profession              String
  employer                String
  jobTitle                String                      @map("job_title")
  industry                String
  yearsExperience         Int                         @map("years_experience")
  expertiseAreas          Json                        @map("expertise_areas")
  mentoringFormats        Json                        @map("mentoring_formats")
  maxMentees              Int                         @default(5) @map("max_mentees")
  currentMentees          Int                         @default(0) @map("current_mentees")
  availability            Json
  hoursPerMonth           Int                         @map("hours_per_month")
  motivation              String                      @db.Text
  backgroundCheckStatus   MentorBackgroundCheckStatus @map("background_check_status")
  backgroundCheckDate     DateTime?                   @map("background_check_date") @db.Date
  backgroundCheckExpiry   DateTime?                   @map("background_check_expiry") @db.Date
  backgroundCheckDocument String?                     @map("background_check_document")
  trainingCompleted       Boolean                     @default(false) @map("training_completed")
  trainingCompletedDate   DateTime?                   @map("training_completed_date") @db.Date
  safeguardingAgreed      Boolean                     @default(false) @map("safeguarding_agreed")
